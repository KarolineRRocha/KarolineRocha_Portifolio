# =============================================================================
# Environment Variables for Karoline Rocha Portfolio
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# =============================================================================
# API Configuration
# =============================================================================
PORTFOLIO_API_URL=http://localhost:3000/api

# =============================================================================
# GitHub Configuration
# =============================================================================
# Your GitHub username
PORTFOLIO_GITHUB_USERNAME=KarolineRRocha
# GitHub Personal Access Token (get from GitHub Settings > Developer settings > Personal access tokens)
PORTFOLIO_GITHUB_TOKEN=your_github_personal_access_token_here

# =============================================================================
# Email Configuration (EmailJS)
# =============================================================================
# EmailJS Service ID
PORTFOLIO_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
# EmailJS Template ID
PORTFOLIO_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
# EmailJS User ID
PORTFOLIO_EMAILJS_USER_ID=your_emailjs_user_id_here

# =============================================================================
# Admin Configuration
# =============================================================================
# Admin username/email
PORTFOLIO_ADMIN_USERNAME=your_admin_email@example.com
# Admin password (use a strong password)
PORTFOLIO_ADMIN_PASSWORD=your_secure_admin_password_here

# =============================================================================
# Firebase Configuration
# =============================================================================
# Firebase API Key
PORTFOLIO_FIREBASE_API_KEY=your_firebase_api_key_here
# Firebase Auth Domain
PORTFOLIO_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# Firebase Database URL
PORTFOLIO_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.region.firebasedatabase.app
# Firebase Project ID
PORTFOLIO_FIREBASE_PROJECT_ID=your_project_id
# Firebase Storage Bucket
PORTFOLIO_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
# Firebase Messaging Sender ID
PORTFOLIO_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# Firebase App ID
PORTFOLIO_FIREBASE_APP_ID=your_app_id
# Firebase Measurement ID (Google Analytics)
PORTFOLIO_FIREBASE_MEASUREMENT_ID=your_measurement_id
