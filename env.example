# =============================================================================
# Environment Variables for Karoline Rocha Portfolio
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# =============================================================================
# API Configuration
# =============================================================================
API_URL=http://localhost:3000/api

# =============================================================================
# GitHub Configuration
# =============================================================================
# Your GitHub username
GITHUB_USERNAME=KarolineRRocha
# GitHub Personal Access Token (get from GitHub Settings > Developer settings > Personal access tokens)
GITHUB_TOKEN=your_github_personal_access_token_here

# =============================================================================
# Email Configuration (EmailJS)
# =============================================================================
# EmailJS Service ID
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
# EmailJS Template ID
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
# EmailJS User ID
EMAILJS_USER_ID=your_emailjs_user_id_here

# =============================================================================
# Admin Configuration
# =============================================================================
# Admin username/email
ADMIN_USERNAME=your_admin_email@example.com
# Admin password (use a strong password)
ADMIN_PASSWORD=your_secure_admin_password_here

# =============================================================================
# Firebase Configuration
# =============================================================================
# Firebase API Key
FIREBASE_API_KEY=your_firebase_api_key_here
# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# Firebase Database URL
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.region.firebasedatabase.app
# Firebase Project ID
FIREBASE_PROJECT_ID=your_project_id
# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# Firebase App ID
FIREBASE_APP_ID=your_app_id
# Firebase Measurement ID (Google Analytics)
FIREBASE_MEASUREMENT_ID=your_measurement_id
